{
  "name": "jira-lint",
  "version": "0.0.1",
  "description": "Add JIRA issue details to your GitHub pull request",
  "main": "lib/index.js",
  "scripts": {
    "prebuild": "engines-ok && rm -rf lib",
    "build": "ncc build src/main.ts -o lib -m",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "prettier --check src/**/*.ts && eslint src/**/*.ts",
    "docs:toc": "markdown-toc -i --bullets='-' README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cleartax/jira-lint"
  },
  "engines": {
    "node": ">= 18",
    "npm": ">=8"
  },
  "type": "module",
  "keywords": [
    "actions",
    "node",
    "setup",
    "github",
    "pr-description",
    "labels",
    "jira",
    "jira-issue"
  ],
  "author": "cleartax",
  "license": "MIT",
  "husky": {
    "hooks": {
      "pre-push": "./scripts/pre-push.sh",
      "pre-commit": "lint-staged && ./scripts/pre-commit.sh"
    }
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@octokit/action": "^7.0.0",
    "string-similarity": "^4.0.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.7",
    "@types/node": "^22.2.0",
    "@types/string-similarity": "^4.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "@vercel/ncc": "^0.38.1",
    "axios": "^1.7.3",
    "engines-ok": "^1.2.0",
    "eslint-plugin-github": "^5.0.1",
    "eslint-plugin-jest": "^28.8.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.4",
    "install": "^0.13.0",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "lint-staged": "^15.2.8",
    "lodash": "^4.17.21",
    "markdown-toc": "^1.2.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.4",
    "typescript": "^5.5.4"
  }
}
